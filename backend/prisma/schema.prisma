generator client {
  provider = "prisma-client-js"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String // This will store the hashed password, never plain text
  role     Role   @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reviews   Review[]
}

model Category {
  id            String        @id @default(uuid())
  nameEn        String        @unique
  nameHi        String        @unique
  slug          String        @unique
  descriptionEn String?
  descriptionHi String?
  subcategories Subcategory[]
  pujas         Puja[] // <--- Add this opposite relation
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Subcategory {
  id         String   @id @default(uuid())
  nameEn     String
  nameHi     String
  slug       String   @unique
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  pujas      Puja[] // <--- Add this opposite relation
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Puja {
  id            String       @id @default(uuid())
  titleEn       String
  titleHi       String
  slug          String       @unique
  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  imageUrl      String?
  placeOfPuja   String // e.g., "Temple / Home"
  noOfYajman    String // e.g., "1-4 Persons"
  estimatedTime String // e.g., "30 to 45 min"
  charges       String // (e.g., "₹2100" or "2500")
  samagri       String? // Puja samagri text
  about         String? // About puja text
  benefits      String? // Benefits text
  faqs          PujaFaq[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  bookings      Booking[]
  reviews       Review[]
}

model PujaFaq {
  id         String  @id @default(uuid())
  pujaId     String
  puja       Puja    @relation(fields: [pujaId], references: [id], onDelete: Cascade)
  questionEn String
  answerEn   String
  questionHi String?
  answerHi   String?
}

model Booking {
  id        String   @id @default(uuid())
  pujaId    String
  puja      Puja     @relation(fields: [pujaId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  email     String?
  address   String
  status    String   @default("PENDING")
  bookingDate DateTime?
  createdAt DateTime @default(now())
}

model Muhurat {
  id          String   @id @default(uuid())
  date        DateTime @db.Date // English calendar date (YYYY-MM-DD)
  tithi       String   // e.g., "शुक्ल पक्ष एकादशी" or "Ekadashi"
  muhurat     String   // e.g., "Abhijit Muhurat (11:45 AM - 12:35 PM)"
  details     String?  @db.Text // Full details or guidelines
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}

model Panchang {
  id        String   @id @default(uuid())
  date      DateTime @unique @db.Date // Ensures one entry per day (YYYY-MM-DD)
  data      Json     // Stores the entire complex Panchang JSON object
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model Review {
  id          String   @id @default(uuid())
  
  // Relations
  pujaId      String
  puja        Puja     @relation(fields: [pujaId], references: [id], onDelete: Cascade)
  
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Reviewer Details (Allows guests or logged-in users)
  userName    String
  userCity    String?  // e.g. "Indore", "Delhi"

  // Content & Metrics
  rating      Int      // 1 to 5 stars
  comment     String   @db.Text
  
  // Moderation & Status
  isApproved  Boolean  @default(false) // Must be approved by Admin before showing on Web App
  isFeatured  Boolean  @default(false) // Pin to Home page or top of Puja page

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([pujaId])
  @@index([isApproved])
}